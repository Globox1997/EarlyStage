{
  "schemaVersion": 1,
  "id": "earlystage",
  "version": "${version}",
  "name": "EarlyStage",
  "description": "This mod adds a couple of early features",
  "authors": [
    "Globox_Z"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/earlystage",
    "sources": "https://github.com/Globox1997/EarlyStage",
    "issues": "https://github.com/Globox1997/EarlyStage/issues"
  },
  "license": "MIT",
  "icon": "assets/earlystage/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.earlystage.fabric.EarlyStageFabric"
    ],
    "client": [
      "net.earlystage.EarlyStageClient"
    ],
    "modmenu": [
      "net.earlystage.config.ModMenuIntegration"
    ],
    "jei_mod_plugin": [
      "net.earlystage.compat.EarlyStageJeiPlugin"
    ],
    "dehydration": [
      "net.earlystage.compat.EarlyStageDehydrationIntegration"
    ]
  },
  "mixins": [
    "earlystage.mixins.json"
  ],
  "depends": {
    "java": ">=${java_version}",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}"
  }
}